# ---------------------------------------------------------------------------
# Game server (required)
# ---------------------------------------------------------------------------
# Base URL of the Python game server. The admin app reads it in the browser, so
# it must carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLIENT_URL=https://game.darkube.ir

# ---------------------------------------------------------------------------
# Cross-app links (optional)
# ---------------------------------------------------------------------------
# Where the docs page sends a facilitator who wants to open the player app.
# Falls back to a sensible default when unset.
# NEXT_PUBLIC_PLAYER_APP_URL=http://localhost:7009
