{
	"extends": "@workspace/typescript-config/nextjs.json",
	"compilerOptions": {
		"types": ["node", "react"],
		"lib": ["dom", "esnext"],
		"target": "esnext",
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@workspace/ui/*": ["../../packages/ui/src/*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"next-env.d.ts",
		"next.config.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
