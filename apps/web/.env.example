# ---------------------------------------------------------------------------
# Game server (required in every environment)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLIENT_URL=https://game.darkube.ir
NEXT_PUBLIC_SERVER_URL=https://game.darkube.ir
GAME_API_URL=https://game.darkube.ir

# Link target for the admin app, used by the docs page.
# NEXT_PUBLIC_ADMIN_APP_URL=https://admin.example.com

# ---------------------------------------------------------------------------
# Messaging storage
# ---------------------------------------------------------------------------
# Local development: persistent SQLite, no separate database service.
# Requires Node 22+ for node:sqlite.
COMMUNICATION_STORAGE=sqlite
COMMUNICATION_SQLITE_PATH=.data/communication.sqlite

# Serverless / multi-instance (Vercel): SQLite CANNOT be used. Each invocation
# gets a fresh, ephemeral filesystem, so messages would be silently lost.
# Leave COMMUNICATION_STORAGE unset (or set it to "mongodb") and provide a URI.
# COMMUNICATION_STORAGE=mongodb
# MONGODB_URI=mongodb://host:27017/?authSource=admin
# MONGODB_DB_NAME=game_db
#
# Credentials may live inside MONGODB_URI, or be supplied separately.
# Supplying only a password does nothing - the user is required too.
# MONGODB_USER=root
# MONGODB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Optional game-mode permissions. Keep disabled unless the mode allows them.
# ---------------------------------------------------------------------------
COMMUNICATION_ALLOW_PUBLIC_ANNOUNCEMENTS=false
COMMUNICATION_ALLOW_PLAYER_ENEMY_MESSAGES=false
NEXT_PUBLIC_COMMUNICATION_ALLOW_PUBLIC_ANNOUNCEMENTS=false

# Set to "mock" only for isolated local UI development.
NEXT_PUBLIC_COMMUNICATION_MODE=server
