            "default": "voting"
          },
          "timeout_sec": {
            "type": "integer",
            "title": "Timeout Sec",
            "default": 30
          },
          "poll_ms": {
            "type": "integer",
            "title": "Poll Ms",
            "default": 200
          },
          "stop_on_finish": {
            "type": "boolean",
            "title": "Stop On Finish",
            "default": true
          }
        },
        "type": "object",
        "title": "WaitForPhaseRequest"
      }
    }
  }
