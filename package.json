		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"prettier": "^3.6.2",
		"turbo": "^2.5.5",
		"typescript": "5.7.3"
	},
	"packageManager": "pnpm@10.18.3",
	"engines": {
		"node": ">=24"
	}
}
